# Copy this file to .env and update the values below

# Application Settings
APP_NAME=LSI SmartTrack
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lsi_smarttrack
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Announcement notification providers (keep real values only in .env)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=LSI SmartTrack
BREVO_API_KEY=
BREVO_SENDER_NAME=LSI SmartTrack
BREVO_SENDER_EMAIL=noreply@example.com
SMARTTRACK_PUBLIC_URL=http://localhost:5176