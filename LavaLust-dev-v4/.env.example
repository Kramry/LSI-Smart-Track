# Copy this file to .env and update the values below

# Application Settings
APP_NAME=LSI SmartTrack
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lsi_smarttrack
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Announcement notification provider (keep real values only in .env)
BREVO_API_KEY=
BREVO_SENDER_NAME=LSI SmartTrack
BREVO_SENDER_EMAIL=noreply@example.com
SMARTTRACK_PUBLIC_URL=http://localhost:5176
# Frontend origin only. Used to construct Xendit success and cancel returns.
SMARTTRACK_FRONTEND_URL=http://localhost:5176
SMARTTRACK_FRONTEND_ORIGIN=http://localhost:5176

# Xendit online payments (keep the secret key and webhook token private)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Configure this backend endpoint in the Xendit Dashboard webhook settings.
# Local development: use the current public ngrok URL forwarding to localhost:8000.
# Production: https://lsi-smart-track.onrender.com/api/payments/xendit/webhook

# Google Gemini analytics insights (server-side only; never expose these values to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
