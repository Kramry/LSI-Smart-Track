# Copy this file to .env and update the values below

# Application Settings
APP_NAME=LSI SmartTrack
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lsi_smarttrack
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Announcement notification provider (keep real values only in .env)
BREVO_API_KEY=
BREVO_SENDER_NAME=LSI SmartTrack
BREVO_SENDER_EMAIL=noreply@example.com
SMARTTRACK_PUBLIC_URL=http://localhost:5176

# Xendit online payments (keep the secret key and webhook token private)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_SUCCESS_URL=http://localhost:5176/payments?payment=success
XENDIT_FAILURE_URL=http://localhost:5176/payments?payment=failed

# PostHog server reporting API (Personal API Key; never expose this value to the browser)
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# PostHog browser capture (public project key; collection starts only after user consent)
POSTHOG_PROJECT_API_KEY=
POSTHOG_INGESTION_HOST=https://us.i.posthog.com
